{"inkVersion":21,"root":[[["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":[["#","^speaker: Wanderer Elara","/#","^Well met, friend. Would you care to hear a tale from the road?","\n","ev","str","^I'd love to hear it.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^No time for stories.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"tell_tale"},{"#f":5}],"c-1":["\n",{"->":"decline"},{"#f":5}]}],{"#f":1}],"tell_tale":["#","^speaker: Wanderer Elara","/#","^Three days past, I saw a dragon soaring over the mountains. A magnificent sight!","\n","#","^speaker: Wanderer Elara","/#","^May your path be filled with wonder, friend.","\n","end",{"#f":1}],"decline":["#","^speaker: Wanderer Elara","/#","^Perhaps another time. Farewell.","\n","end",{"#f":1}],"global decl":["end",null],"#f":1}],"listDefs":{}}
