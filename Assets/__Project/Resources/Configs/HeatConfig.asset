  _modifiers:
  - _id: enemies-first
    _displayName: They Strike First
    _kind: 0
    _ranks:
    - _heatValue: 2
      _magnitude: 1
      _description: Enemies act before you every round, not only when they start the
        fight.
  - _id: raised-floor
    _displayName: Older Things Wake
    _kind: 1
    _ranks:
    - _heatValue: 2
      _magnitude: 1
      _description: The creature floor rises one escalation tier - tougher things prowl
        from the first platform.
    - _heatValue: 2
      _magnitude: 1
      _description: The creature floor rises a second tier - the deep-run bestiary
        greets you at the door.
  - _id: stingy-cauldron
    _displayName: The Cauldron Skimps
    _kind: 2
    _ranks:
    - _heatValue: 1
      _magnitude: 1
      _description: Every unseal offers one fewer form to choose from.
    - _heatValue: 2
      _magnitude: 1
      _description: Every unseal offers yet another form fewer - take what the pot
        deigns to give.
  - _id: fewer-sockets
    _displayName: Thinner Medallions
    _kind: 3
    _ranks:
    - _heatValue: 2
      _magnitude: 1
      _description: Every medallion carries one fewer reagent socket (never below
        one).
  _floorReliefRunsPerHeat: 0.5
  _biasStrengthLiftPerHeat: 0.15
  _reserveDirectionSlotMinHeat: 4
