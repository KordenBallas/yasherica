{"inkVersion":21,"root":[[["done",{"#f":5,"#n":"g-0"}],null],"done",{"trigger_combat":[{"temp=":"enemy_count"},"ev","void","/ev","~ret",{"#f":1}],"start":[["#","^platform_type: simple","/#","#","^key_node: true","/#","#","^priority: 0","/#","^You awaken on a floating platform, the world stretching endlessly below.","\n","^A path of stone and magic leads forward into the mist.","\n","ev","str","^Look around","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Move forward","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["^ ",{"->":"look_around"},"\n",{"#f":5}],"c-1":["^ ",{"->":"move_forward"},"\n",{"#f":5}]}],{"#f":1}],"look_around":[["^The platform beneath you hums with ancient power.","\n","^Runes etched into the stone pulse with a faint blue light.","\n","^In the distance, you can make out other platforms connected by bridges of light.","\n","ev","str","^Continue forward","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["^ ",{"->":"move_forward"},"\n",{"#f":5}]}],{"#f":1}],"move_forward":["^You step onto the bridge, feeling it solidify under your feet.","\n","^Ahead, you see a figure standing near a small stall.","\n",{"->":"merchant_intro"},{"#f":1}],"merchant_intro":[["#","^platform_type: dialogue","/#","#","^npc: merchant_tomas","/#","#","^key_node: true","/#","#","^priority: 1","/#","#","^speaker: Merchant Tomas","/#","^\"Ah, a traveler! Welcome, welcome!\"","\n","^The merchant, a stout man with a warm smile, gestures to his wares.","\n","#","^speaker: Merchant Tomas","/#","^\"I am Tomas. These platforms can be treacherous for the unprepared. Perhaps I can help?\"","\n","ev","str","^\"What do you sell?\"","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^\"Tell me about this place.\"","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^\"Who are you?\"","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^Leave","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["^ ",{"->":"merchant_wares"},"\n",{"#f":5}],"c-1":["^ ",{"->":"merchant_lore"},"\n",{"#f":5}],"c-2":["^ ",{"->":"merchant_who"},"\n",{"#f":5}],"c-3":["^ ",{"->":"merchant_leave"},"\n",{"#f":5}]}],{"#f":1}],"merchant_who":[["ev",true,"/ev",{"VAR=":"has_met_merchant","re":true},"#","^speaker: Merchant Tomas","/#","^\"I'm just a humble trader, making my way through the platforms like everyone else.\"","\n","#","^speaker: Merchant Tomas","/#","^\"Been doing this for... oh, must be twenty years now. These stones have stories, traveler.\"","\n","ev","str","^\"What stories?\"","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^\"What do you sell?\"","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^\"Goodbye.\"","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["^ ",{"->":"merchant_lore"},"\n",{"#f":5}],"c-1":["^ ",{"->":"merchant_wares"},"\n",{"#f":5}],"c-2":["^ ",{"->":"merchant_leave"},"\n",{"#f":5}]}],{"#f":1}],"merchant_wares":[["ev",true,"/ev",{"VAR=":"has_met_merchant","re":true},"#","^speaker: Merchant Tomas","/#","^\"Potions, trinkets, the occasional weapon... whatever travelers need!\"","\n","#","^speaker: Merchant Tomas","/#","^\"Gold is scarce in these parts, but I'm always fair in my dealings.\"","\n","ev","str","^\"I'll browse later.\"","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^\"Tell me about this place.\"","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["^ ",{"->":"merchant_leave"},"\n",{"#f":5}],"c-1":["^ ",{"->":"merchant_lore"},"\n",{"#f":5}]}],{"#f":1}],"merchant_lore":[["ev",true,"/ev",{"VAR=":"has_met_merchant","re":true},"#","^speaker: Merchant Tomas","/#","^\"These platforms? Ancient, older than any kingdom. Some say gods built them.\"","\n","#","^speaker: Merchant Tomas","/#","^\"But be careful ahead. There's been reports of bandits on the next few platforms.\"","\n","ev","str","^\"Bandits?\"","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^\"Thank you for the warning.\"","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["^ ",{"->":"merchant_bandit_warning"},"\n",{"#f":5}],"c-1":["^ ",{"->":"merchant_leave"},"\n",{"#f":5}]}],{"#f":1}],"merchant_bandit_warning":[["#","^speaker: Merchant Tomas","/#","^\"Aye, rough folk. They prey on travelers. If you see them, best to talk your way out...\"","\n","#","^speaker: Merchant Tomas","/#","^\"...or be ready for a fight. They don't take kindly to resistance.\"","\n","ev","str","^\"I can handle myself.\"","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^\"Thanks for the advice.\"","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["^ ",{"->":"merchant_leave"},"\n",{"#f":5}],"c-1":["^ ",{"->":"merchant_leave"},"\n",{"#f":5}]}],{"#f":1}],"merchant_leave":["#","^speaker: Merchant Tomas","/#","^\"Safe travels, friend! Come back if you need anything.\"","\n","end",{"#f":1}],"bandit_encounter":[["#","^platform_type: combat","/#","#","^npc: bandit_leader","/#","#","^npc_can_become_enemy: true","/#","#","^enemy_id: 1","/#","#","^key_node: true","/#","#","^priority: 2","/#","^A rough-looking figure blocks your path, hand resting on a sword hilt.","\n","#","^speaker: Bandit","/#","^\"Hold there, traveler. This here's a toll road now.\"","\n","ev","str","^\"How much?\"","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^\"I won't pay.\"","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^Attack immediately","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["^ ",{"->":"bandit_toll"},"\n",{"#f":5}],"c-1":["^ ",{"->":"bandit_refuse"},"\n",{"#f":5}],"c-2":["^ ",{"->":"bandit_attack"},"\n",{"#f":5}]}],{"#f":1}],"bandit_toll":[["#","^speaker: Bandit","/#","^\"Smart one, eh? Ten gold pieces, and you pass unharmed.\"","\n","ev",{"VAR?":"gold"},10,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","ev","str","^Pay the toll","/str","/ev",{"*":".^.c-0","flg":4},{"->":".^.^.^.11"},{"c-0":["^ ",{"->":"bandit_paid"},"\n",{"#f":5}]}]}],"nop","\n","ev","str","^\"That's too much.\"","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^\"I'd rather fight.\"","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["^ ",{"->":"bandit_negotiate"},"\n",{"#f":5}],"c-1":["^ ",{"->":"bandit_refuse"},"\n",{"#f":5}]}],{"#f":1}],"bandit_negotiate":[["#","^speaker: Bandit","/#","^\"Too much? Ha! Consider it a... survival tax.\"","\n","^The bandit grins, revealing missing teeth.","\n","#","^speaker: Bandit","/#","^\"But I'm feeling generous. Five gold, final offer.\"","\n","ev",{"VAR?":"gold"},5,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","ev","str","^Pay five gold","/str","/ev",{"*":".^.c-0","flg":4},{"->":".^.^.^.18"},{"c-0":["^ ",{"->":"bandit_paid"},"\n",{"#f":5}]}]}],"nop","\n","ev","str","^\"No deal.\"","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Attack","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["^ ",{"->":"bandit_refuse"},"\n",{"#f":5}],"c-1":["^ ",{"->":"bandit_attack"},"\n",{"#f":5}]}],{"#f":1}],"bandit_paid":["ev",{"VAR?":"gold"},5,"-","/ev",{"VAR=":"gold","re":true},"#","^speaker: Bandit","/#","^\"Wise choice. Move along then, and don't come back this way without more coin!\"","\n","^The bandit steps aside, counting your gold with a satisfied smirk.","\n","end",{"#f":1}],"bandit_refuse":["#","^speaker: Bandit","/#","^\"Wrong answer, friend.\"","\n","^The bandit draws their sword.","\n",{"->":"bandit_attack"},{"#f":1}],"bandit_attack":["#","^outcome: Combat","/#","^The bandit lunges at you with blade drawn!","\n","ev",true,"/ev",{"VAR=":"bandit_hostile","re":true},"ev",1,{"x()":"trigger_combat","exArgs":1},"pop","/ev","\n","end",{"#f":1}],"chapter_end":["#","^platform_type: cutscene","/#","#","^key_node: true","/#","#","^priority: 10","/#","^The path opens to a grand vista. More platforms stretch into the distance, each holding secrets untold.","\n","^Your journey has only just begun.","\n","end",{"#f":1}],"global decl":["ev","str","^Traveler","/str",{"VAR=":"player_name"},false,{"VAR=":"has_met_merchant"},false,{"VAR=":"bandit_hostile"},0,{"VAR=":"gold"},"/ev","end",null],"#f":1}],"listDefs":{}}