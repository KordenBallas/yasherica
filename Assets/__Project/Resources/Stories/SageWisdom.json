{"inkVersion":21,"root":[[["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":[["#","^speaker: Sage Mortimer","/#","^Ah, a seeker of knowledge approaches. What wisdom do you seek?","\n","ev","str","^Tell me about the ancient prophecy.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^I seek nothing from you.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"wisdom"},{"#f":5}],"c-1":["\n",{"->":"leave"},{"#f":5}]}],{"#f":1}],"wisdom":["#","^speaker: Sage Mortimer","/#","^The prophecy speaks of a hero who will rise when darkness falls. Perhaps that hero is you.","\n","#","^speaker: Sage Mortimer","/#","^Use this knowledge wisely, young one.","\n","#","^outcome: Quest","/#","end",{"#f":1}],"leave":["#","^speaker: Sage Mortimer","/#","^Then why disturb an old man's studies? Begone.","\n","end",{"#f":1}],"global decl":["end",null],"#f":1}],"listDefs":{}}
